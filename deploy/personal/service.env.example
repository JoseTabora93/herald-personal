HERALD_PERSONAL_DATA_DIR=/var/lib/herald-personal/data
HERALD_PERSONAL_TOKEN_FILE=/var/lib/herald-personal/private/api-token
HERALD_PERSONAL_MAIL_DRAFT_ENABLED=false
HERALD_PERSONAL_MAIL_ARCHIVE_ENABLED=false
TZ=America/Tegucigalpa
# Optional delegated Microsoft 365 access. Use a private cache on this server.
# HERALD_MICROSOFT365_MSAL_CACHE=/var/lib/herald-personal/private/microsoft365-msal.json
# HERALD_MICROSOFT365_CLIENT_ID=your-application-id
# HERALD_MICROSOFT365_TENANT_ID=your-tenant-id
# Optional Gmail token file, refreshed by the operator's OAuth client.
# HERALD_GMAIL_TOKEN_FILE=/var/lib/herald-personal/private/gmail-token
